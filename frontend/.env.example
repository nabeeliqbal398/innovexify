# Server-side only: where the Next.js server forwards /api/* requests (see next.config.mjs). The browser never sees this.
# Local development: the API on this machine. In docker compose it is http://api:4000.
API_ORIGIN=http://localhost:4000

# Public values only. Nothing secret belongs in a NEXT_PUBLIC_ variable: it is shipped to every browser.
NEXT_PUBLIC_APP_NAME=Innovexify
# Shows the "simulate a direct request" buttons in the Access & scenarios panel (they call real endpoints and are audited).
NEXT_PUBLIC_ENABLE_DEMO_TOOLS=false
