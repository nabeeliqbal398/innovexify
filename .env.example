# Values for the root docker-compose.yml. Copy to .env (git-ignored) and change every password and secret.

POSTGRES_USER=innovexify
POSTGRES_PASSWORD=change-me-before-first-run
POSTGRES_DB=innovexify

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-characters

# The address people open in the browser. Invitation links are built from it.
APP_URL=http://localhost:3000
WEB_PORT=3000

# true when the API sits behind a proxy you control (the web app's /api rewrite counts), so rate limits see the real client address.
TRUST_PROXY=true
LOG_LEVEL=info
MAX_UPLOAD_MB=25
