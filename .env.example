# Values for the root docker-compose.yml. Copy to .env (git-ignored) and change every password and secret.

POSTGRES_USER=innovexify
POSTGRES_PASSWORD=change-me-before-first-run
POSTGRES_DB=innovexify

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-characters

# The address people open in the browser. Invitation and password-reset links are built from it.
APP_URL=http://localhost:3000
WEB_PORT=3000

# How many reverse proxies in front of this stack add the client's address to X-Forwarded-For (GO-LIVE.md, item 2). The web app's own /api proxy
# adds nothing, so it does not count.
#   false = none: the web port is reachable directly (safe; every caller counts as one address for the rate limits)
#   1     = ONE reverse proxy (Caddy, or nginx with $proxy_add_x_forwarded_for) sits in front: the usual production layout
# Never set 1 without such a proxy: any caller could then name their own address and walk around the rate limits.
TRUST_PROXY=false
LOG_LEVEL=info
MAX_UPLOAD_MB=25

# Sign-in, accept-invitation and password-reset limits (requests per minute). Refresh is limited per session (REFRESH_THROTTLE_LIMIT) with a per-address ceiling.
AUTH_THROTTLE_LIMIT=5
REFRESH_THROTTLE_LIMIT=120
REFRESH_IP_CEILING=1200
PASSWORD_RESET_TTL_MINUTES=30

# Email. Production sends real email: the API refuses to start with MAIL_TRANSPORT=log, or with smtp and a missing value below.
# (To try the stack on one machine, add the trial mail server: docker compose -f docker-compose.yml -f docker-compose.local-mail.yml up -d)
MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Innovexify <no-reply@your-domain.example>
# true only for a relay on a trusted private network that has no TLS.
SMTP_ALLOW_PLAINTEXT=false

# Backups (scripts/backup.sh and scripts/backup.ps1): where they go and how many of each kind to keep.
BACKUP_DIR=./backups
BACKUP_KEEP=14
