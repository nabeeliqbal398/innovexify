# Copy to .env (git-ignored) and change the password. Never commit real credentials.

POSTGRES_USER=innovexify
POSTGRES_PASSWORD=change-me-before-first-run
POSTGRES_DB=innovexify
# If 5432 is taken on your machine, change this and DATABASE_URL follows.
POSTGRES_PORT=5432

# Prisma pool size per API process. Keep (connection_limit x API instances) under Postgres max_connections (100 by default).
# 10 suits one API instance on a small database; lower it if you run several instances.
DB_CONNECTION_LIMIT=10

# Host is `localhost` when the API runs on your machine (npm run start:dev).
# Inside docker compose (docker-compose.prod.yml) the host is `db`; that file sets its own DATABASE_URL.
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public&connection_limit=${DB_CONNECTION_LIMIT}"

# API
PORT=4000
# Comma-separated list of origins allowed to call the API from a browser. Behind the web app's /api proxy the browser only calls its own
# origin, so production needs none: when this is unset the list is empty in production (no CORS headers at all) and this value in development.
CORS_ORIGINS=http://localhost:3000

# Optional, only for `docker compose --profile tools up -d pgadmin`
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me-too
PGADMIN_PORT=5050

# Password given to every seeded account (dev only). Required by `npm run db:seed`; it is hashed with Argon2id.
# Never reuse a real password here. Must be 12+ characters with an uppercase letter and a number.
SEED_PASSWORD=Change-Me-Seed-2026

# Logging and rate limiting
LOG_LEVEL=info
# Global limit per client IP; sign-in and token routes have their own stricter limit (5 per minute).
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
# Sign-in (counted per address AND email), accept-invitation, password change and password reset: requests per minute. Keep 5 in production (the browser tests raise it).
AUTH_THROTTLE_LIMIT=5
# /auth/refresh and /auth/logout, per client address. Every page load refreshes, so this is much higher than the sign-in limit.
REFRESH_THROTTLE_LIMIT=120

# Authentication. Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
INVITATION_TTL_DAYS=7
# Brute-force protection: lock an account for this long after this many failed sign-ins in a row.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Frontend URL used to build invitation and password-reset links.
APP_URL=http://localhost:3000
# A password-reset link works once and for this many minutes.
PASSWORD_RESET_TTL_MINUTES=30

# Email. log = write the email (links included) to the API log and send nothing: development and tests only, refused when NODE_ENV=production.
# smtp = send for real: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD and MAIL_FROM are all required (the API fails at start-up without them).
MAIL_TRANSPORT=log
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Innovexify <no-reply@your-domain.example>
# Port 465 is encrypted from the first byte; any other port must upgrade with STARTTLS in production. true allows plain SMTP (a trusted private relay).
# SMTP_ALLOW_PLAINTEXT=false

# Refresh tokens are set as an httpOnly cookie (Secure in production, SameSite as below).
# They are also accepted and returned in JSON bodies only when this is true. Keep it false in production.
ALLOW_BODY_REFRESH=false
# SameSite of the refresh cookie: strict (default; frontend and API on the same site), lax, or none (frontend on
# another site). "none" is rejected at startup unless the cookie is Secure: set NODE_ENV=production, or
# REFRESH_COOKIE_SECURE=true when you terminate HTTPS yourself in another environment.
REFRESH_COOKIE_SAMESITE=strict
REFRESH_COOKIE_SECURE=false
# How many reverse proxies in front of the API ADD the client's address to X-Forwarded-For: false = none (default), 1 = one, 2 = two. "true" means 1.
# The web app's own /api proxy adds nothing and does not count. Never "trust everything": entries the client wrote itself are never believed.
TRUST_PROXY=false
# Seeding is always refused when NODE_ENV=production (there is no override). Create the first Admin with `npm run admin:create`.

# File storage for client documents. Local disk for now; keep it OUTSIDE any web-served folder and back it up with the database.
# Created at startup. Relative paths resolve from where the API is started. In Docker, mount a volume here.
STORAGE_DIR=./storage
# Largest accepted upload in megabytes (1-100). Larger files are refused with a message saying so.
MAX_UPLOAD_MB=25
# Malware scanning of every upload. none = no scan (development). clamav = scan with a clamd daemon (docker run -p 3310:3310 clamav/clamav);
# if the scanner cannot be reached the upload is refused, never accepted unscanned.
VIRUS_SCANNER=none
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000

# Per-person limits (a specific message is returned when one is exceeded).
MESSAGE_RATE_LIMIT_PER_MIN=30
SEARCH_RATE_LIMIT_PER_MIN=60
# A client may reopen a Resolved ticket for this many days after it was resolved (0 = never).
TICKET_REOPEN_DAYS=7
# Analytics results are cached in memory this long (0 = off). Swap for Redis when you run more than one API instance.
ANALYTICS_CACHE_SECONDS=60

# Development and browser tests only (ignored in production): append every email the log mailer "sends" to this file, one JSON line each.
# MAIL_OUTBOX_FILE=./mail-outbox.jsonl

# Tests wipe their database, so they only run against a name ending in _e2e or _test. By default these are derived from POSTGRES_DB
# (innovexify_test for `npm run test:e2e`, innovexify_e2e for the browser tests). Set this only to point at another throw-away database (CI does);
# anything else is refused.
# E2E_DATABASE_URL=postgresql://user:password@localhost:5432/innovexify_e2e?schema=public
